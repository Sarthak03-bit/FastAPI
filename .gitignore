# .gitignore for Python / FastAPI project

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Translations
*.mo
*.pot

# Env / virtualenv
.env
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# pyenv
.python-version

# mypy
.mypy_cache/
.dmypy.json

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs and databases
*.log
*.sqlite3
*.db

# FastAPI / Uvicorn / Gunicorn
*.pid
gunicorn.socket

# Misc
.pytest_cache/
.env.*
__pypackages__/
*.egg
